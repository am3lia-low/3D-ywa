{
  "name": "persistent-storyworld-spatial-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "contracts:generate": "node scripts/generate-contract-schemas.mjs",
    "models:generate": "node scripts/generate-models.mjs",
    "assets:import:polyhaven": "node scripts/import-polyhaven-assets.mjs",
    "assets:prepare:quality": "node scripts/prepare-polyhaven-lods.mjs",
    "assets:convert:glb": "node scripts/convert-external-glb.mjs",
    "assets:support:generate": "node scripts/generate-safe-mesh-support.mjs",
    "assets:support:check": "node scripts/generate-safe-mesh-support.mjs --check",
    "assets:validate": "node scripts/validate-asset-kits.mjs",
    "assets:report": "node scripts/validate-asset-kits.mjs --write",
    "part1:mock": "node scripts/mock-part1-server.mjs",
    "scenes:preflight": "vitest run src/integration/scenePreflight.test.ts --reporter=verbose",
    "handoff:check": "vitest run src/integration/publicApi.test.tsx --reporter=verbose",
    "comfyui:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-comfyui.ps1",
    "comfyui:serve": "powershell -ExecutionPolicy Bypass -File scripts/run-comfyui.ps1",
    "comfyui:prove": "powershell -ExecutionPolicy Bypass -File scripts/prove-comfyui.ps1",
    "triposr:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-triposr.ps1",
    "triposr:serve": "powershell -ExecutionPolicy Bypass -File scripts/run-triposr.ps1",
    "triposr:prove": "powershell -ExecutionPolicy Bypass -File scripts/prove-triposr.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm test && pnpm typecheck && pnpm assets:support:check && pnpm scenes:preflight && pnpm assets:validate && pnpm build && pnpm bundle:check"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "gltfpack": "1.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
