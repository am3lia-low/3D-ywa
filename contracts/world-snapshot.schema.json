{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "storyId": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "$ref": "#/$defs/__schema1"
    },
    "passageId": {
      "$ref": "#/$defs/__schema0"
    },
    "locations": {
      "$ref": "#/$defs/__schema2"
    },
    "entities": {
      "$ref": "#/$defs/__schema5"
    },
    "relations": {
      "$ref": "#/$defs/__schema7"
    },
    "conflicts": {
      "$ref": "#/$defs/__schema8"
    }
  },
  "required": [
    "storyId",
    "version",
    "passageId",
    "locations",
    "entities",
    "relations",
    "conflicts"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bounds": {
          "$ref": "#/$defs/__schema4"
        },
        "environment": {
          "type": "object",
          "properties": {
            "floorColor": {
              "type": "string"
            },
            "wallColor": {
              "type": "string"
            },
            "ambientColor": {
              "type": "string"
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": {}
    },
    "__schema4": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ]
    },
    "__schema5": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "$ref": "#/$defs/__schema0"
          },
          "locationId": {
            "$ref": "#/$defs/__schema0"
          },
          "assetKey": {
            "$ref": "#/$defs/__schema0"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transform": {
            "type": "object",
            "properties": {
              "position": {
                "$ref": "#/$defs/__schema6"
              },
              "rotation": {
                "$ref": "#/$defs/__schema6"
              },
              "scale": {
                "$ref": "#/$defs/__schema6"
              }
            },
            "additionalProperties": {}
          },
          "dimensions": {
            "$ref": "#/$defs/__schema4"
          },
          "state": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "provenance": {
            "type": "object",
            "properties": {
              "passageId": {
                "$ref": "#/$defs/__schema0"
              },
              "sentence": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "passageId"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "locationId"
        ],
        "additionalProperties": {}
      }
    },
    "__schema6": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ]
    },
    "__schema7": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "subjectId": {
            "$ref": "#/$defs/__schema0"
          },
          "predicate": {
            "$ref": "#/$defs/__schema0"
          },
          "objectId": {
            "$ref": "#/$defs/__schema0"
          },
          "distance": {
            "type": "number",
            "minimum": 0
          },
          "metadata": {
            "type": "object",
            "properties": {
              "wall": {
                "type": "string",
                "enum": [
                  "north",
                  "south",
                  "east",
                  "west"
                ]
              }
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "subjectId",
          "predicate"
        ],
        "additionalProperties": {}
      }
    },
    "__schema8": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "entityId": {
            "$ref": "#/$defs/__schema0"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "ignored"
            ]
          },
          "passageIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "id",
          "description",
          "status"
        ],
        "additionalProperties": {}
      }
    }
  },
  "$id": "https://persistent-storyworld.local/contracts/WorldSnapshot",
  "title": "WorldSnapshot"
}
